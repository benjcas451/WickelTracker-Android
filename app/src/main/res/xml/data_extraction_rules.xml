<?xml version="1.0" encoding="utf-8"?><!--
   Regeln fuer Android 12+ (API 31+): Cloud-Backup und Geraete-Transfer
   werden bewusst unterschiedlich behandelt.

   Sobald ein <include> gesetzt ist, wird ausschliesslich das Aufgefuehrte
   gesichert - die Regeln unten sind also eine vollstaendige Whitelist.

   Cloud-Backup laeuft ueber Google-Server: dorthin gehen nur die Nutzdaten
   (SQLite), nicht aber wickel_settings.xml. Diese Datei enthaelt den
   API-Key (Zugangsdaten) und cert_folder_uri - eine SAF-Ordner-URI, deren
   persistierte Leseberechtigung ein Geraetewechsel ohnehin nicht ueberlebt.

   Der Geraete-Transfer laeuft direkt und Ende-zu-Ende-verschluesselt zwischen
   altem und neuem Geraet. Dort duerfen die Einstellungen mit, damit der
   Umzug nahtlos ist; die Zertifikats-URI wird nach dem Transfer neu
   angefordert (CertSource prueft persistedUriPermissions).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="wickel_settings.xml" />
    </device-transfer>
</data-extraction-rules>
